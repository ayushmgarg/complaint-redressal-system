# ============================================================
# Mr. Civil — Complaint Redressal System
# Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# NEVER commit .env to version control.
# ============================================================

# --- Supabase ---
# Your Supabase project URL (found in Settings > API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (used for client operations)
SUPABASE_KEY=your_supabase_anon_key_here

# --- Flask Security ---
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret-key

# --- Storage Buckets ---
# Names of your Supabase Storage buckets (create these in your Supabase dashboard)
COMPLAINT_BUCKET=complaint-images
WORK_BUCKET=work-images

# --- Escalation Settings ---
# Contact details shown to citizens when they want to escalate a complaint
ESCALATION_EMAIL=grievance@mrcivil.gov.in
ESCALATION_TWITTER_HANDLE=MrCivilGrievance

# --- Server Settings (for production) ---
# Port to listen on (Render sets this automatically)
PORT=5000
