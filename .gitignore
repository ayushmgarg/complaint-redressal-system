# ============================================================
# Mr. Civil — Complaint Redressal System .gitignore
# ============================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
wheels/
pip-wheel-metadata/
MANIFEST

# ---- Virtual Environments ----
.env
.venv
venv/
ENV/
env/
env.bak/
venv.bak/

# ---- Environment / Secrets ----
# NEVER commit .env — it contains real credentials
.env
*.secret
secret.py
secrets.py

# ---- Local dev & test utility scripts ----
# These are one-off scripts used during development, not part of the app
addV.py
check_buckets.py
test_upload.py
create_admin.py
seed_data.py
debug_*.py
scratch_*.py

# ---- Flask / Werkzeug ----
instance/
.webassets-cache
flask_session/

# ---- Logs ----
*.log
logs/
log/

# ---- Database ----
*.db
*.sqlite
*.sqlite3
db.sqlite3
db.sqlite3-journal

# ---- Uploads / media (use Supabase storage instead) ----
uploads/
media/
temp_uploads/

# ---- IDE & Editor ----
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ---- OS generated ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---- Testing & coverage ----
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# ---- Type checkers ----
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/

# ---- Build tools ----
.Python
develop-eggs/
downloads/
eggs/
lib/
lib64/
parts/
sdist/
var/
share/python-wheels/
.installed.cfg
*.spec
*.manifest

# ---- Jupyter ----
.ipynb_checkpoints
profile_default/
ipython_config.py

# ---- pyenv ----
.python-version

# ---- Celery ----
celerybeat-schedule
celerybeat.pid

# ---- mkdocs ----
/site

# ---- Rope ----
.ropeproject

# ---- Spyder ----
.spyderproject
.spyproject

# ---- Node (if any frontend tooling is added) ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.yarn-integrity

# ---- Temp ----
*.tmp
*.temp
temp/
tmp/

# ---- Render / deployment artifacts ----
.render-buildinfo.json
